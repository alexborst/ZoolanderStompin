{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Game": {
    "debounceMilliseconds": 30,
    "presentationsPerRound": 20,
    "roundCount": 2,
    "preventConsecutiveRepeat": true,
    "interTargetGapMilliseconds": 250,
    "winPercentThreshold": 60,
    "selectTimeoutSeconds": 30,
    "selectTimeoutAction": "AutoStartEasy",
    "countdownGetReadyMilliseconds": 1500,
    "countdownGoMilliseconds": 700,
    "intermissionMilliseconds": 2000,
    "resultsMilliseconds": 3000,
    "attractLampCycleMilliseconds": 400,
    "freePlay": false,
    "coinsPerCredit": 1,
    "easy": {
      "padsInPlay": [ 1, 2, 3, 4 ],
      "hitWindowMilliseconds": 1200
    },
    "medium": {
      "padsInPlay": [ 1, 2, 3, 4, 5, 6 ],
      "hitWindowMilliseconds": 900
    },
    "hard": {
      "padsInPlay": [ 1, 2, 3, 4, 5, 6, 7 ],
      "hitWindowMilliseconds": 650
    },
    "payout": {
      "mode": "PercentageTable",
      "fixedTickets": 0,
      "table": [
        { "minPercentInclusive": 0, "maxPercentInclusive": 19, "tickets": 0 },
        { "minPercentInclusive": 20, "maxPercentInclusive": 39, "tickets": 1 },
        { "minPercentInclusive": 40, "maxPercentInclusive": 59, "tickets": 2 },
        { "minPercentInclusive": 60, "maxPercentInclusive": 79, "tickets": 4 },
        { "minPercentInclusive": 80, "maxPercentInclusive": 99, "tickets": 6 },
        { "minPercentInclusive": 100, "maxPercentInclusive": 100, "tickets": 8 }
      ]
    }
  }
}
